{
  "functions": {
    "api/draft.js": {
      "includeFiles": "output/**/*.html"
    }
  },
  "rewrites": [
    {
      "source": "/assets/agency-card.png",
      "destination": "/api/business-card"
    },
    {
      "source": "/go/kakao",
      "destination": "/api/kakao"
    },
    {
      "source": "/",
      "destination": "/output/index.html"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/output/:path"
    }
  ]
}
