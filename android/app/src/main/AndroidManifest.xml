<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
          Logged-out ("secret") Naver search viewer, opened from the MIH dashboard (PWA) keyword links:
          intent://search?q=<keyword>&post=<blog post url>#Intent;scheme=mihsecret;package=com.bpstudio.mih.secret;...
          Runs in its own process with its own WebView data directory, so it never shares cookies with
          Chrome or anything else, and that directory is wiped on every open.
        -->
        <activity
            android:name=".SecretActivity"
            android:exported="true"
            android:process=":secret"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mihsecret" />
            </intent-filter>
        </activity>
    </application>
</manifest>
